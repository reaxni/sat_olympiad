# Development only: set to unavailable to preview the service failure state.
VITE_DEV_API_MODE=mock
# Optional future Go service, e.g. /api/v1. Leave blank to fail closed in production.
VITE_API_BASE_URL=
# Public, domain-restricted Desmos API key. No calculator loads without it.
VITE_DESMOS_API_KEY=
# Development-only scenarios: countdown, exam, released, expired-code, network-error.
VITE_MOCK_SCENARIO=countdown
VITE_MOCK_OPEN_DELAY_SECONDS=120
# Simulated server-clock speed. 1 uses real time; 120 speeds up expiry testing.
VITE_MOCK_CLOCK_RATE=1
